<div class="container">
  <h1>Chore Scoreboard</h1>
  <table>
    <thead>
      <tr>
        <th>Rank</th>
        <th>Resident</th>
        <th>Points</th>
      </tr>
    </thead>
    <tbody>
      {{#each residents}}
        <tr>
          <td>#{{this.rank}}</td>
          <td>{{this.name}}</td>
          <td>{{this.points}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>